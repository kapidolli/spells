    "cmake_kitware": {
      "url": "https://github.com/Kitware/CMake/releases/download/v4.3.5/cmake-4.3.5-windows-x86_64.zip",
      "version": "4.3.5",
      "sha256": "c05a60d22d5df22d75a72ae9b6628ef5f20daee4f4ba380920e1fbbeaf244fc1",
      "notes": "Kitware's Authenticode-signed CMake distribution (52979296 bytes), extracted into build/toolchain/cmake by build/bootstrap_toolchain.py. Used instead of MSYS2's unsigned cmake.exe because Smart App Control on the reference machine blocks that file persistently (CodeIntegrity event 3077, policy {0283ac0f-fff1-49ae-ada1-8a933130cad6}) while signed binaries pass. Hash cross-checked against the release's cmake-4.3.5-SHA-256.txt."
    },
    "inno_setup": {
      "url": "https://github.com/jrsoftware/issrc/releases/download/is-6_2_2/innosetup-6.2.2.exe",
      "version": "6.2.2",
      "sha256": "8117d10d00a2ad33a1390978ea3872861c330e087914410a6377b22c4c5b8563",
      "notes": "Inno Setup 6 command-line compiler (ISCC.exe) for spec 19.3 step 7. The installer exe is never run: build/bootstrap_packaging.py unpacks its {app} files with innoextract into build/toolchain/innosetup/, so nothing lands in Program Files, the registry, or PATH and no elevation is asked for (spec 19.2). 6.2.2 rather than the newest 6.x because the pinned innoextract 1.9 is the newest innoextract release and reads Inno Setup up to 6.2.2: 6.3.0 changed the setup data format ('Unexpected setup data version') and 6.5.0 changed the setup loader revision. Every [Setup] directive spec 19.3 step 7 needs (PrivilegesRequired=lowest, DefaultDirName, nocompression, PrepareToInstall, CloseApplications, AppMutex, UninstallRun, LicenseFile) exists in 6.2.2."
    },
    "innoextract": {
      "url": "https://github.com/dscharrer/innoextract/releases/download/1.9/innoextract-1.9-windows.zip",
      "version": "1.9",
      "sha256": "6989342c9b026a00a72a38f23b62a8e6a22cc5de69805cf47d68ac2fec993065",
      "notes": "innoextract 1.9 Windows build (520705 bytes), the newest release, extracted into build/toolchain/innoextract/ by build/bootstrap_packaging.py and used to unpack the pinned Inno Setup installer without running it. Flat zip: innoextract.exe at the root next to doc/, license/, README.txt, CHANGELOG.txt and VERSION.txt."
    },
    "pyinstaller": {
      "url": "https://files.pythonhosted.org/packages/24/83/c5422204772a27aef643280fdc887b7ef55679989096b21dceb1b9625fc4/pyinstaller-6.22.3-py3-none-win_amd64.whl",
      "version": "6.22.3",
      "sha256": "500bd58c7bf7e584a8435adccbd763a0b918d5c12b08d74ff50fd79b2915458b",
      "notes": "PyInstaller wheel for the one-folder app build of spec 19.3 step 5, also listed as pyinstaller==6.22.3 in the pyproject dev extras. Release page: https://pypi.org/project/pyinstaller/6.22.3/. The pinned url is the wheel itself rather than that page so the entry is hash-verifiable and `py build/fetch.py --all` keeps working; build/bootstrap_packaging.py fetches it into build/cache/ and pip-installs that exact file into .venv, which pulls the wheel's own dependencies from PyPI by name."
    }
