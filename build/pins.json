    },
    "qwen3_5_4b_q4_k_m": {
      "url": "https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/main/Qwen3.5-4B-Q4_K_M.gguf",
      "version": "unsloth/Qwen3.5-4B-GGUF@main",
      "sha256": "00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4",
      "size_bytes": 2740937888,
      "notes": "The cleanup and writing model a machine with a graphics card installs (data/models/catalog.json ids qwen3.5-4b-q4_k_m and qwen3.5-4b-q4_k_m-compose, B5-46), upstream Qwen/Qwen3.5-4B, Apache-2.0. It never reaches the offline installer, which ships the processor set. 2740937888 bytes; hash computed 2026-09-17 from the copy already in build/cache/models and cross-checked against the Hugging Face LFS object hash for that path (tree API lfs.oid)."
    }
