function AdapterMemoryBytes(const SubKey: String): Int64;
var
  Raw: AnsiString;
  I: Integer;
  Value: Int64;
  Small: Cardinal;
begin
  Result := 0;
  if RegQueryBinaryValue(HKEY_LOCAL_MACHINE, SubKey, 'HardwareInformation.qwMemorySize', Raw) then
  begin
    Value := 0;
    for I := Length(Raw) downto 1 do
      Value := Value * 256 + Ord(Raw[I]);
    Result := Value;
  end
  else if RegQueryDWordValue(HKEY_LOCAL_MACHINE, SubKey, 'HardwareInformation.MemorySize',
                             Small) then
    Result := Small;
end;

function DiscreteGpuPresent(): Boolean;
var
  Names: TArrayOfString;
  I: Integer;
  Desc: String;
  Memory: Int64;
begin
  Result := False;
  try
    if not RegGetSubkeyNames(HKEY_LOCAL_MACHINE, DisplayClassKey, Names) then
    begin
      Log('Spells: no display adapter list in the registry, taking the processor models');
      Exit;
    end;
    for I := 0 to GetArrayLength(Names) - 1 do
    begin
      if Length(Names[I]) <> 4 then
        Continue;
      if not RegQueryStringValue(HKEY_LOCAL_MACHINE, DisplayClassKey + '\' + Names[I],
                                 'DriverDesc', Desc) then
        Continue;
      Memory := AdapterMemoryBytes(DisplayClassKey + '\' + Names[I]);
      Log('Spells: display adapter ' + Desc + ' has ' + IntToStr(Memory) +
          ' bytes of its own video memory');
      if Memory >= StrToInt64(DiscreteVideoMemoryText) then
        Result := True;
    end;
  except
    Log('Spells: the display adapters could not be read (' + GetExceptionMessage() +
        '), taking the processor models');
    Result := False;
  end;
end;

function MachineClass(): Integer;
begin
  if (SmallModelBox <> nil) and SmallModelBox.Checked then
    Result := ClassProcessor
  else
    Result := DetectedClass;
end;

function SizeToText(Bytes: Int64): String;
var
  Whole, Tenths: Int64;
begin
  Whole := Bytes div 1000000000;
  Tenths := ((Bytes mod 1000000000) * 10) div 1000000000;
  Result := IntToStr(Whole) + '.' + IntToStr(Tenths) + ' GB';
end;

function LanguageWanted(Index: Integer): Boolean;
begin
  Result := LanguagePage.Values[Index];
end;

function CurrentMask(): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to GetArrayLength(LanguageCodes) - 1 do
    if LanguageWanted(I) then
      Result := Result + (1 shl I);
end;

function CurrentSet(): Integer;
var
  I: Integer;
  Mask, Hardware: Integer;
begin
  Result := -1;
  Mask := CurrentMask();
  Hardware := MachineClass();
  for I := 0 to GetArrayLength(InstallSets) - 1 do
    if (InstallSets[I].Hardware = Hardware) and (InstallSets[I].Mask = Mask) then
    begin
      Result := I;
      Exit;
    end;
end;

function FileWanted(Index: Integer): Boolean;
var
  Row: Integer;
begin
  Result := False;
  Row := CurrentSet();
  if Row < 0 then
    Exit;
  Result := Pos(',' + IntToStr(Index) + ',', ',' + InstallSets[Row].Files + ',') > 0;
end;

function AlreadyInstalled(Index: Integer): Boolean;
var
  Existing: String;
  Size: Int64;
begin
  Result := False;
  Existing := AddBackslash(WizardDirValue()) + 'models\' + ModelFiles[Index].Name;
  if not FileExists(Existing) then
    Exit;
  if not FileSize64(Existing, Size) then
    Exit;
  Result := Size = ModelFiles[Index].Size;
end;

function NeedsDownload(Index: Integer): Boolean;
begin
  Result := FileWanted(Index) and not AlreadyInstalled(Index);
end;

function MissingBytes(): Int64;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to GetArrayLength(ModelFiles) - 1 do
    if NeedsDownload(I) then
      Result := Result + ModelFiles[I].Size;
end;

function SelectedReason(): String;
var
  Row: Integer;
begin
  Result := '';
  Row := CurrentSet();
  if Row >= 0 then
    Result := InstallSets[Row].Reason;
end;

function AnyLanguageWanted(): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to GetArrayLength(LanguageCodes) - 1 do
    if LanguageWanted(I) then
    begin
      Result := True;
      Exit;
    end;
end;

procedure LanguagesClicked(Sender: TObject);
var
  Missing: Int64;
begin
  ModelLabel.Caption := SelectedReason();
  Missing := MissingBytes();
  if Missing > 0 then
    TotalLabel.Caption := 'This choice downloads about ' + SizeToText(Missing) + '.'
  else
    TotalLabel.Caption := 'Spells already has the model files for this choice, so there is ' +
      'nothing to download.';
end;

function JoinModelUrl(const BaseUrl, FileName: String): String;
var
  Base: String;
begin
  Base := Trim(BaseUrl);
  while (Length(Base) > 0) and (Base[Length(Base)] = '/') do
    Base := Copy(Base, 1, Length(Base) - 1);
  if Base = '' then
    Result := ''
  else
    Result := Base + '/' + FileName;
end;

function SourcesFor(Index: Integer; var Urls: TArrayOfString): Integer;
var
  Mirrored: String;
begin
  Mirrored := JoinModelUrl(DefaultMirrorUrl, ModelFiles[Index].Name);
  if Mirrored = '' then
  begin
    SetArrayLength(Urls, 1);
    Urls[0] := ModelFiles[Index].Url;
    Result := 1;
  end
  else
  begin
    SetArrayLength(Urls, 2);
    Urls[0] := Mirrored;
    Urls[1] := ModelFiles[Index].Url;
    Result := 2;
  end;
end;

procedure NoteSkipped(const Purpose: String);
begin
  if SkippedPurposes = '' then
    SkippedPurposes := Purpose
  else
    SkippedPurposes := SkippedPurposes + ', ' + Purpose;
end;

function OnDownloadProgress(const Url, FileName: String; const Progress, ProgressMax: Int64): Boolean;
begin
  if not TextShown then
  begin
    DownloadPage.SetText(CurrentLabel,
      'Part ' + IntToStr(PartNumber) + ' of ' + IntToStr(PartCount) + ', ' +
      SizeToText(DoneBytes) + ' of ' + SizeToText(TotalBytes) + ' in all');
    TextShown := True;
  end;
  Result := True;
end;

function DownloadOne(Index: Integer): Boolean;
var
  Urls: TArrayOfString;
  Count, Attempt, Answer: Integer;
  Failure, Question: String;
begin
  Count := SourcesFor(Index, Urls);
  while True do
  begin
    for Attempt := 0 to Count - 1 do
    begin
      DownloadPage.Clear();
      DownloadPage.Add(Urls[Attempt], ModelFiles[Index].Name, ModelFiles[Index].Hash);
      TextShown := False;
      try
        DownloadPage.Download();
        Result := True;
        Exit;
      except
        Failure := GetExceptionMessage();
      end;
      if DownloadPage.AbortedByUser then
      begin
        Log('Spells: the download of ' + ModelFiles[Index].Name + ' was cancelled');
        SetupAborted := True;
        Result := False;
        Exit;
      end;
      Log('Spells: ' + ModelFiles[Index].Name + ' failed from ' + Urls[Attempt] + ': ' + Failure);
      if Attempt + 1 < Count then
        Log('Spells: trying the next address for ' + ModelFiles[Index].Name);
    end;
    Question := 'Spells could not finish a download: ' + CurrentLabel + '.' + #13#10#13#10 +
      'Yes: try again.' + #13#10 +
      'No: install without it. Spells will start with ' + ModelFiles[Index].Purpose +
      ' unavailable until the file is in the models folder. The offline installer ' +
      OfflineInstallerName + ', which carries every model already, is the one to use on a ' +
      'machine with no network.' + #13#10 +
      'Cancel: stop the installation.' + #13#10#13#10 +
      'The installation log records what went wrong.';
    Answer := SuppressibleMsgBox(Question, mbError, MB_YESNOCANCEL, IDNO);
    if Answer = IDCANCEL then
    begin
      SetupAborted := True;
      Result := False;
      Exit;
    end;
    if Answer = IDNO then
    begin
      NoteSkipped(ModelFiles[Index].Purpose);
      Result := False;
      Exit;
    end;
  end;
end;

function WantedCount(): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to GetArrayLength(ModelFiles) - 1 do
    if NeedsDownload(I) then
      Result := Result + 1;
end;

function DownloadModels(): Boolean;
var
  I: Integer;
begin
  SetupAborted := False;
  SkippedPurposes := '';
  PartNumber := 0;
  PartCount := WantedCount();
  DoneBytes := 0;
  TotalBytes := MissingBytes();
  if PartCount = 0 then
  begin
    Log('Spells: every model this choice needs is already in the models folder');
    Result := True;
    Exit;
  end;
  DownloadPage.Show();
  try
    for I := 0 to GetArrayLength(ModelFiles) - 1 do
    begin
      if NeedsDownload(I) then
      begin
        PartNumber := PartNumber + 1;
        CurrentLabel := ModelFiles[I].Title + ', ' + SizeToText(ModelFiles[I].ModelSize);
        if (not DownloadOne(I)) and SetupAborted then
          Break;
        DoneBytes := DoneBytes + ModelFiles[I].Size;
      end;
    end;
  finally
    DownloadPage.Hide();
  end;
  Result := not SetupAborted;
  if Result and (SkippedPurposes <> '') then
    SuppressibleMsgBox('Spells will be installed without ' + SkippedPurposes + '.' + #13#10#13#10 +
      'Add the missing files to the models folder later, or use the offline installer ' +
      OfflineInstallerName + ', which carries every model.', mbInformation, MB_OK, IDOK);
end;

procedure MoveDownloadedModels();
var
  I: Integer;
  Source, Target: String;
begin
  ForceDirectories(ExpandConstant('{app}\models'));
  for I := 0 to GetArrayLength(ModelFiles) - 1 do
  begin
    Source := ExpandConstant('{tmp}\') + ModelFiles[I].Name;
    if FileExists(Source) then
    begin
      Target := ExpandConstant('{app}\models\') + ModelFiles[I].Name;
      DeleteFile(Target);
      if RenameFile(Source, Target) then
        Log('Spells: moved ' + ModelFiles[I].Name + ' into the models folder')
      else if FileCopy(Source, Target, False) then
        Log('Spells: copied ' + ModelFiles[I].Name + ' into the models folder')
      else
        Log('Spells: could not place ' + ModelFiles[I].Name + ' in the models folder');
    end;
  end;
end;

procedure WriteFirstRunFile();
var
  I: Integer;
  Codes, Text: String;
begin
  Codes := '';
  for I := 0 to GetArrayLength(LanguageCodes) - 1 do
    if LanguageWanted(I) then
    begin
      if Codes <> '' then
        Codes := Codes + ', ';
      Codes := Codes + '"' + LanguageCodes[I] + '"';
    end;
  Text := '{"enabled_languages": [' + Codes + ']}' + #13#10;
  if SaveStringToFile(ExpandConstant('{app}\first-run.json'), Text, False) then
    Log('Spells: wrote the first-run language choice ' + Codes)
  else
    Log('Spells: could not write the first-run language choice');
end;

procedure InitializeWizard();
begin
  InitModelManifest();
  InitInstallSets();
  if DiscreteGpuPresent() then
    DetectedClass := ClassGraphics
  else
    DetectedClass := ClassProcessor;

  LanguagePage := CreateInputOptionPage(wpSelectDir,
    'Languages',
    'Which languages will you dictate in?',
    'Spells downloads the models these languages need on this machine. ' +
    'More languages can be added later in Settings, which downloads what they need then.',
    False, False);
  InitLanguageList();
  LanguagePage.CheckListBox.Height := ScaleY(76);
  LanguagePage.CheckListBox.OnClickCheck := @LanguagesClicked;

  ModelLabel := TNewStaticText.Create(LanguagePage);
  ModelLabel.Parent := LanguagePage.Surface;
  ModelLabel.Left := 0;
  ModelLabel.Top := LanguagePage.CheckListBox.Top + LanguagePage.CheckListBox.Height + ScaleY(12);
  ModelLabel.Width := LanguagePage.SurfaceWidth;
  ModelLabel.AutoSize := False;
  ModelLabel.WordWrap := True;
  ModelLabel.Height := ScaleY(34);

  TotalLabel := TNewStaticText.Create(LanguagePage);
  TotalLabel.Parent := LanguagePage.Surface;
  TotalLabel.Left := 0;
  TotalLabel.Top := ModelLabel.Top + ModelLabel.Height + ScaleY(6);
  TotalLabel.Width := LanguagePage.SurfaceWidth;
  TotalLabel.AutoSize := False;
  TotalLabel.Height := ScaleY(18);

  SmallModelBox := TNewCheckBox.Create(LanguagePage);
  SmallModelBox.Parent := LanguagePage.Surface;
  SmallModelBox.Left := 0;
  SmallModelBox.Top := TotalLabel.Top + TotalLabel.Height + ScaleY(10);
  SmallModelBox.Width := LanguagePage.SurfaceWidth;
  SmallModelBox.Height := ScaleY(20);
  SmallModelBox.Checked := False;
  SmallModelBox.Caption := 'Use the smaller, faster writing model instead';
  SmallModelBox.Visible := DetectedClass = ClassGraphics;
  SmallModelBox.OnClick := @LanguagesClicked;
  LanguagesClicked(nil);

  DownloadPage := CreateDownloadPage('Downloading the models',
    'Each file is checked against the hash this build records for it before it is kept.',
    @OnDownloadProgress);
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = LanguagePage.ID then
    LanguagesClicked(nil);
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if CurPageID = LanguagePage.ID then
  begin
    if not AnyLanguageWanted() then
    begin
      MsgBox('Pick at least one language. Spells needs a speech model to dictate with.',
        mbError, MB_OK);
      Result := False;
    end;
  end
  else if CurPageID = wpReady then
    Result := DownloadModels();
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep <> ssPostInstall then
    Exit;
  MoveDownloadedModels();
  WriteFirstRunFile();
end;

function AskToRemoveUserData(): Boolean;
var
  Form: TSetupForm;
  Prompt: TNewStaticText;
  Box: TNewCheckBox;
  OkButton: TNewButton;
begin
  Result := False;
  Form := CreateCustomForm();
  try
    Form.Caption := 'Uninstall Spells';
    Form.ClientWidth := ScaleX(420);
    Form.ClientHeight := ScaleY(150);
    Form.Position := poScreenCenter;

    Prompt := TNewStaticText.Create(Form);
    Prompt.Parent := Form;
    Prompt.Left := ScaleX(16);
    Prompt.Top := ScaleY(16);
    Prompt.Width := Form.ClientWidth - ScaleX(32);
    Prompt.AutoSize := False;
    Prompt.Height := ScaleY(48);
    Prompt.WordWrap := True;
    Prompt.Caption := 'Spells keeps your settings, vocabulary and dictation history outside the' +
      ' program folder. They are kept by default so a reinstall picks them up again.';

    Box := TNewCheckBox.Create(Form);
    Box.Parent := Form;
    Box.Left := ScaleX(16);
    Box.Top := ScaleY(76);
    Box.Width := Form.ClientWidth - ScaleX(32);
    Box.Height := ScaleY(20);
    Box.Checked := False;
    Box.Caption := 'Also remove my settings, history and logs';

    OkButton := TNewButton.Create(Form);
    OkButton.Parent := Form;
    OkButton.Width := ScaleX(90);
    OkButton.Height := ScaleY(26);
    OkButton.Left := Form.ClientWidth - ScaleX(106);
    OkButton.Top := Form.ClientHeight - ScaleY(42);
    OkButton.Caption := 'Continue';
    OkButton.ModalResult := mrOk;
    Form.ActiveControl := OkButton;

    Result := (Form.ShowModal() = mrOk) and Box.Checked;
  finally
    Form.Free();
  end;
end;

function OtherInstallModeHasSpells(): Boolean;
begin
  if IsAdminInstallMode() then
    Result := RegKeyExists(HKEY_CURRENT_USER, UninstallKey)
  else
    Result := RegKeyExists(HKEY_LOCAL_MACHINE, UninstallKey);
end;

function InitializeSetup(): Boolean;
begin
  Result := True;
  if not OtherInstallModeHasSpells() then
    Exit;
  Result := False;
  if IsAdminInstallMode() then
  begin
    Log('Spells: refusing an all-users install beside the copy installed for this user only');
    SuppressibleMsgBox('Spells is already installed for your account only. Uninstall that copy first ' +
      '(Settings, Apps, Installed apps), then run this installer again to install Spells for all users.',
      mbError, MB_OK, IDOK);
  end
  else
  begin
    Log('Spells: refusing a per-user install beside the copy installed for all users');
    SuppressibleMsgBox('Spells is already installed for all users of this computer, so it is ready ' +
      'for your account too. To update it, run this installer again and choose Install for all users.',
      mbError, MB_OK, IDOK);
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := True;
  RemoveUserData := ExpandConstant('{param:REMOVEDATA|0}') = '1';
  if RemoveUserData then
    Log('Spells: /REMOVEDATA=1 was passed, the user data folders go too')
  else if not UninstallSilent() then
    RemoveUserData := AskToRemoveUserData();
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep <> usPostUninstall then
    Exit;
  if RegValueExists(HKEY_CURRENT_USER, RunKey, RunValue) then
  begin
    Log('Spells: removing the autostart Run value');
    RegDeleteValue(HKEY_CURRENT_USER, RunKey, RunValue);
  end;
  if not RemoveUserData then
    Exit;
  Log('Spells: removing the user data folders');
  DelTree(ExpandConstant('{userappdata}\Spells'), True, True, True);
  DelTree(ExpandConstant('{localappdata}\Spells'), True, True, True);
end;
